# Copy to .env (git-ignored). Nothing here is required for the Mac slice.
# Needed only for gated models such as meta-llama/Llama-3.1-8B-Instruct:
HF_TOKEN=
# Where model artifacts are stored (default: ./models)
LLM_SHEET_MODELS_DIR=
# Where pinned runtime binaries/venvs live (default: ./.tools)
LLM_SHEET_TOOLS_DIR=
